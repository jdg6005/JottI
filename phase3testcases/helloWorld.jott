    }

    Return 6;
}
Def main[]:Void{
    Integer x;
    x = 5;
    If[x > 5] {
        ::print["hi"];
    } Elseif[x > 4] {
        ::print["hi"];
    } Elseif[x > 3] {
        ::print["hi"];
    } Else {
        ::print["hi"];
